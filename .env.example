# Copy this file to .env and paste your own key. Never commit .env.

# Anthropic API key (you paste your own)
ANTHROPIC_API_KEY=paste-your-key-here

# Model tiers. Swappable; model.py is the source of truth (finalised in Step 4).
FAST_MODEL=claude-sonnet-5
JUDGMENT_MODEL=claude-opus-4-8

# Real mode is multi-user: each person creates their own account in the app, and
# their records are encrypted with their password. No account env vars are needed.

# Durable storage for real accounts and records. Leave the R2 vars blank to store
# locally (a private, encrypted archive under local_records/cloud/ on this
# machine). Set them on a hosted deploy so records persist: create a Cloudflare R2
# bucket and an S3 API token, then fill these in (keep them out of git).
R2_BUCKET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cost-safety (every read spends the operator's API budget). The public demo
# leads with zero-cost pre-baked sample runs; DEMO_LIVE_UPLOADS caps the live
# "try your own file" trials per browser session. REAL_UPLOADS_PER_DAY caps
# documents one real account may read per day.
DEMO_LIVE_UPLOADS=2
REAL_UPLOADS_PER_DAY=25
REAL_CHATS_PER_DAY=30   # questions a real account may ask on the Ask page per day

# Shared invite code for "Use it for real". Leave blank for no gate (local use).
# Set it on a public deploy so only people you give the code to can create an
# account or sign in, keeping unknown visitors off your API key. Rotate by
# changing this value. Each user still has their own personal account password.
REAL_ACCESS_CODE=
